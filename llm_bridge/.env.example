ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides (defaults shown)
# LLM_BRIDGE_MODEL=claude-sonnet-5
# LLM_BRIDGE_THINKING_MODE=adaptive      # adaptive (Sonnet 5 / Opus 5) | enabled (older models e.g. claude-haiku-4-5-20251001) | off
# LLM_BRIDGE_EFFORT=high                 # low | medium | high | xhigh | max  (adaptive mode; below high the model may skip thinking)
# LLM_BRIDGE_THINKING_DISPLAY=summarized # summarized | omitted (adaptive mode; omitted hides thinking text but still bills it)
# LLM_BRIDGE_THINKING_BUDGET=2048        # enabled mode only
# LLM_BRIDGE_MAX_TOKENS=8000
